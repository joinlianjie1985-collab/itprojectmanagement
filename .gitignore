# macOS
.DS_Store

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
.netrc
.npmrc

# Local build output (the Pages workflow builds _site on the runner)
_site/

# Editor scratch
*.swp
*~

# Playwright MCP scratch output
.playwright-mcp/

# Third-party skills — kept out of git (one upstream repo is archived with no
# licence, so it is not ours to redistribute). skills-lock.json pins the source
# and content hash of each. Restore with the `skills add` commands in CLAUDE.md,
# NOT `experimental_install` — that writes to .agents/skills/, which Claude Code
# does not read.
.claude/skills/
